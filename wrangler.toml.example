name = "family-discord-bot"
main = "src/index.ts"
compatibility_date = "2025-09-01"
compatibility_flags = ["nodejs_compat"]

[vars]
TIMEZONE = "Asia/Tokyo"
GUILD_ID = "YOUR_DISCORD_SERVER_ID"
DISCORD_APPLICATION_ID = "YOUR_DISCORD_APPLICATION_ID"
BOT_GOOGLE_EMAIL = "your-family-account@example.com"
# おたよりOCR（Phase 3）
OTAYORI_CHANNEL_ID = "YOUR_OTAYORI_FORUM_CHANNEL_ID"
OTAYORI_DRIVE_FOLDER_ID = "YOUR_DRIVE_FOLDER_ID"
OPENAI_MODEL = "gpt-5-mini"
OPENAI_REASONING_EFFORT = "minimal"
# AIコンシェルジュ（Phase 4）
CONCIERGE_REASONING_EFFORT = "low"
CONCIERGE_MONTHLY_BUDGET_USD = "10"
# 利用額の計算用（gpt-5-mini の料金。モデルや料金が変わったら更新する）
OPENAI_PRICE_INPUT_PER_M = "0.25"
OPENAI_PRICE_OUTPUT_PER_M = "2.00"
# 請求書・支払い管理（Phase 5）
BILLS_CHANNEL_ID = "YOUR_BILLS_FORUM_CHANNEL_ID"
# 転記先のスプレッドシートの ID（URL の /d/ と /edit の間）。家族アカウントが編集できるシートを指定する
BILLS_SHEET_ID = "YOUR_BILLS_SPREADSHEET_ID"
# 医療費の領収書（Phase 6）。このフォルダに「yyyy年医療費」シートと「yyyy年」写真フォルダを年ごとに自動で作る
MEDICAL_CHANNEL_ID = "YOUR_MEDICAL_FORUM_CHANNEL_ID"
MEDICAL_FOLDER_ID = "YOUR_DRIVE_FOLDER_ID"

[[d1_databases]]
binding = "DB"
database_name = "family-discord-bot"
database_id = "YOUR_D1_DATABASE_ID"

# 自動投稿の時刻（UTC で指定。日本時間から 9 時間引く）
#   "0 22 * * *" = 日本時間 7:00  → 今日の予定
#   "0 11 * * *" = 日本時間 20:00 → 明日の予定
# 日本時間の正午より前に実行されたら「今日」、正午以降なら「明日」の予定を投稿する
#   "*/5 * * * *" = 5分おき → 📮おたより等提出 の新しい投稿を確認して OCR（src/index.ts の OTAYORI_CRON と合わせる）
#   "2-59/5 * * * *" = 5分おき（2分ずらす）→ 💸請求書・支払い の転記と支払い状況の同期（src/index.ts の BILLS_CRON と合わせる）
#   "4-59/5 * * * *" = 5分おき（4分ずらす）→ 🏥医療費 の領収書の読み取り・保存・転記（src/index.ts の MEDICAL_CRON と合わせる）
# ※ Cloudflare の無料プランで使える Cron はこれで上限の5つ。増やすときは1つの Cron で複数の処理を回す形に変える
[triggers]
crons = ["0 22 * * *", "0 11 * * *", "*/5 * * * *", "2-59/5 * * * *", "4-59/5 * * * *"]
